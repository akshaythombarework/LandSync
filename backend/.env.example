# ==============================================================================
# NovaaX - Backend Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit your actual .env file to git!

ENVIRONMENT=development
API_V1_STR=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS Allowed Origins (comma-separated or JSON list)
# For production, add your Vercel frontend URL
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Supabase & PostgreSQL Connection
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=land-records
DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@db.your-supabase-project.supabase.co:5432/postgres

# OCR & AI Provider Strategy
# Set OCR_PROVIDER=easyocr for local real inference, or OCR_PROVIDER=mock for fast headless testing
OCR_PROVIDER=easyocr
EXTRACTION_PROVIDER=rule_nlp
OCR_LANGUAGES=en,hi,mr
