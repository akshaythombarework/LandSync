# ==============================================================================
# NovaaX - Frontend Environment Variables (.env.example)
# ==============================================================================
# API base URL for FastAPI backend
# In local dev: http://localhost:8000/api/v1 (or /api/v1 when using Vite proxy)
# In production (Vercel): https://your-backend-service.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase public credentials
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
