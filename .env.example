# ==============================================================================
# NovaaX - Land Record Digitization & Validation Platform
# Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit your actual .env file containing secrets to git!

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
API_V1_STR=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Comma-separated list or JSON array of allowed origins for CORS
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# Database & Supabase Configuration
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=land-records
DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@db.your-supabase-project.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# AI & OCR Engine Configuration
# ------------------------------------------------------------------------------
# OCR provider: 'easyocr' for local ML inference, 'mock' for fast CI / mock mode
OCR_PROVIDER=easyocr
EXTRACTION_PROVIDER=rule_nlp
OCR_LANGUAGES=en,hi,mr

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
# In frontend/.env or .env.local:
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
