# Environment and Secrets (CRITICAL)
.env
.env.local
.env.*.local
.env.production
.env.development
!.env.example
*.pem
*.key
*.cert
*.crt

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
.venv/
env/
ENV/
.pytest_cache/
.coverage
htmlcov/
*.sqlite3

# Node / Vite / Frontend
node_modules/
frontend/node_modules/
dist/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
.turbo/
.next/
out/
.vercel/

# Logs & Runtime
*.log
logs/
*.log.*

# EasyOCR / ML Models cache
.EasyOCR/
*.pth
*.pt

